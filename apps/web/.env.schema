# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Canonical public origin used for metadata, sitemap, robots, and share images.
# Falls back to the Vercel production hostname, then the current public URL.
# @public @optional @type=url
NEXT_PUBLIC_SITE_URL=

# Search engine verification tokens. Add the token from the provider, redeploy,
# then complete verification in Google Search Console or Bing Webmaster Tools.
# @optional
GOOGLE_SITE_VERIFICATION=

# @optional
BING_SITE_VERIFICATION=

# Browser-facing API origin. Leave unset when the web app and API share an
# origin: the browser then calls same-origin `/api/*`, which Vercel rewrites to
# the server service. Local development points this at the API port.
# @public @optional @type=url
NEXT_PUBLIC_SERVER_URL=

# Internal API origin for server-side calls. Docker Compose sets it locally;
# on Vercel the `web` service binding in vercel.json injects it at runtime.
# Falls back to NEXT_PUBLIC_SERVER_URL when unset.
# @public @optional @type=url
SERVER_URL=
