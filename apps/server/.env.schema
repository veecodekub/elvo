# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public base URL of the auth API. Not a secret: browsers see it in OAuth
# redirect URLs and it may legitimately appear in user content.
# @public @type=url
BETTER_AUTH_URL=

# Origin allowed to call this API from browsers. Public by design: it is
# returned in CORS response headers on every cross-origin request.
# @public @type=url
CORS_ORIGIN=

# Public origin visitors use for short links (`/<code>`). Falls back to
# CORS_ORIGIN when unset; set it when the public website domain differs.
# On Vercel Services the website and API share one public origin, so the
# project's production domain is also the short-link origin.
# @public @optional @type=url
PUBLIC_WEB_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Google OAuth is optional for local setup; both values are needed to enable sign-in.
# Client IDs are public by design and appear in OAuth redirect URLs.
# @public @optional @type=string
GOOGLE_CLIENT_ID=

# @optional @type=string
GOOGLE_CLIENT_SECRET=
