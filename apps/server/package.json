{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown && bun run scripts/freeze-env.ts",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"verify:links": "bun run scripts/verify-links.ts",
		"verify:qr": "bun run scripts/verify-qr.ts",
		"verify:analytics": "bun run scripts/verify-analytics.ts",
		"verify:seo": "bun run scripts/verify-seo.ts",
		"analytics:retention": "bun run scripts/retention.ts",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
	},
	"dependencies": {
		"@elvo/auth": "workspace:*",
		"@elvo/db": "workspace:*",
		"@vercel/functions": "^3.10.1",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"evlog": "catalog:",
		"hono": "^4.13.7",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@elvo/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/pngjs": "^6.0.5",
		"jsqr": "^1.4.0",
		"playwright": "^1.64.1",
		"pngjs": "^7.0.0",
		"tsdown": "^0.23.0",
		"typescript": "catalog:",
		"@electric-sql/pglite": "^0.5.14",
		"@neondatabase/serverless": "^1.1.0"
	}
}
