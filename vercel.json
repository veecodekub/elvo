{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"server": {
			"root": "apps/server",
			"framework": "hono"
		},
		"web": {
			"root": "apps/web",
			"framework": "nextjs",
			"bindings": [
				{
					"type": "service",
					"service": "server",
					"format": "url",
					"env": "SERVER_URL"
				}
			]
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": {
				"service": "server"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "web"
			}
		}
	]
}
